# Copie para infra/.env (NUNCA faça commit do .env). Gere segredos com:  openssl rand -base64 48
DOMINIO=app.seucondominio.com.br
POSTGRES_PASSWORD=
GC_APP_PASSWORD=
# Chave de criptografia de CPF/celular/TOTP e dos arquivos (biometria, contratos).
# Guarde uma cópia em local seguro: sem ela os dados cifrados ficam ilegíveis.
APP_CRYPTO_KEY=
# E-mail (convites). Ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
SMTP_FROM=GestaCondomínio <nao-responda@seucondominio.com.br>
# Só em ambiente de TESTE: 1 deixa o 2FA opcional. Em produção deixe 0 (ou vazio).
DESATIVAR_2FA=0
# Só se for publicar a versão web do app do morador em outro domínio
API_ORIGENS=
