# Desenvolvimento local. Copie para apps/web/.env.local (e apps/worker) — nunca faça commit de valores reais.
# Sem DATABASE_URL o painel roda em modo demonstração (dados fictícios em memória).

# Usuário da APLICAÇÃO (gc_app: sem privilégios próprios, só assume anon/authenticated/service_role)
DATABASE_URL=postgres://gc_app:SENHA_DO_GC_APP@127.0.0.1:55339/gc_dev
# Usuário DONO do banco — só para migrações/seed (pnpm db:migrate, pnpm db:seed)
DATABASE_URL_ADMIN=postgres://postgres:postgres@127.0.0.1:55339/gc_dev
GC_APP_PASSWORD=
# Mínimo 32 caracteres. Cifra CPF, celular, TOTP e os arquivos (biometria, contratos).
APP_CRYPTO_KEY=
STORAGE_DIR=./.armazenamento
APP_URL=http://localhost:3000
SMTP_URL=
SMTP_FROM=

# App mobile (apps/mobile/.env): endereço do painel. Vazio = modo demonstração.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
